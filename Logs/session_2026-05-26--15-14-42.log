<![CDATA[
"""
Entry point for the MicroPython project.

This ties together the modules implementing the design artifacts:
- CMP--1 .. CMP--11 components
- FSM--1 state machine
- DAT--1 .. DAT--7 additional data
"""

from core.scheduler import Scheduler


def main():
    sched = Scheduler()
    sched.run()


if __name__ == "__main__":
    main()
