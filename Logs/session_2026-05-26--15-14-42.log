<![CDATA[
"""
Path Planner implementation.

Traces:
- CMP--4 Path Planner
- DAT--2 cost model
"""

from __future__ import annotations

from typing import Dict, Tuple, List, Optional
import math

from .grid_map import GridMap, CellIndex
from .types import PlanningStatus
from . import config


class PathPlanningRequest:
    """Simplified MC_PathPlanningRequest (CMP--1, CMP--4)."""

    def __init__(self, request_id: int, mode: str, start: CellIndex, goals: List[CellIndex]):
        self.request_id = request_id
        self.mode = mode  # "EXPLORE", "RETURN_TO_START", "SECOND_RUN"
        self.start = start
        self.goals = goals


class PathPlanningResponse:
    """PL_PathPlanningResponse (CMP--4)."""

    def __init__(self, request: PathPlanningRequest):
        self.request_id = request.request_id
        self.status: str = PlanningStatus.FAILURE_NO_PATH
        self.path: List[CellIndex] = []
        self.total_cost: float = 0.0
        self.estimated_time_ms: int = 0


class Planner:
    """Dijkstra / A* over grid (CMP--4)."""

    def __init__(self, grid: GridMap):
        self.grid = grid

    def plan(self, req: PathPlanningRequest) -> PathPlanningResponse:
        """Plan path according to CMP--4 Execution (Dijkstra/A*)."""
        resp = PathPlanningResponse(req)
        if not req.goals:
            resp.status = PlanningStatus.INVALID_GOAL
            return resp

        # Single-mode: we use Dijkstra with uniform cell cost and optional turn penalty.
        # For simplicity we treat all edges same, plus a small turn penalty.
        start = req.start
        goals = set(req.goals)

        # Basic Dijkstra over up to 32 cells.
        dist: Dict[CellIndex, float] = {}
        prev: Dict[CellIndex, Tuple[CellIndex, int]] = {}  # cell -> (prev_cell, heading_idx)
        visited: Dict[CellIndex, bool] = {}
        frontier: List[Tuple[float, CellIndex, int]] = []  # (cost, cell, heading)

        # Start with all 4 headings possible; choose 0 with 0 cost.
        start_heading = 0
        dist[start] = 0.0
        prev[start] = (start, start_heading)
        frontier.append((0.0, start, start_heading))

        def pop_min() -> Optional[Tuple[float, CellIndex, int]]:
            if not frontier:
                return None
            # O(N) scan is fine for 32 cells.
            best_i = 0
            best_val = frontier[0][0]
            for i, (c, _, _) in enumerate(frontier):
                if c < best_val:
                    best_val = c
                    best_i = i
            return frontier.pop(best_i)

        goal_reached: Optional[CellIndex] = None
        goal_heading = 0

        while True:
            node = pop_min()
            if node is None:
                break
            cost, cell, heading = node
            if visited.get(cell):
                continue
            visited[cell] = True

            if cell in goals:
                goal_reached = cell
                goal_heading = heading
                break

            # Expand neighbors
            r, c = cell
            for (nr, nc) in self.grid.neighbors4(r, c):
                if not self.grid.is_edge_traversable((r, c), (nr, nc)):
                    continue
                # Determine new heading
                dr = nr - r
                dc = nc - c
                if dr == -1:
                    new_heading = 0  # N
                elif dc == 1:
                    new_heading = 1  # E
                elif dr == 1:
                    new_heading = 2  # S
                else:
                    new_heading = 3  # W

                edge_cost = config.BASE_STRAIGHT_COST
                if new_heading != heading:
                    edge_cost += config.TURN_PENALTY

                new_cost = cost + edge_cost
                old = dist.get((nr, nc))
                if old is None or new_cost < old:
                    dist[(nr, nc)] = new_cost
                    prev[(nr, nc)] = (cell, new_heading)
                    frontier.append((new_cost, (nr, nc), new_heading))

        if goal_reached is None:
            resp.status = PlanningStatus.FAILURE_NO_PATH
            return resp

        # Reconstruct path
        path: List[CellIndex] = []
        cur = goal_reached
        cur_heading = goal_heading
        while True:
            path.append(cur)
            p_cell, p_heading = prev[cur]
            if p_cell == cur:
                break
            cur = p_cell
            cur_heading = p_heading
        path.reverse()
        resp.path = path
        resp.total_cost = dist[goal_reached]

        # Map cost to time estimate; we simply scale by NOMINAL_CELL_TRAVERSAL_MS.
        straight_cells = len(path) - 1
        resp.estimated_time_ms = int(straight_cells * config.NOMINAL_CELL_TRAVERSAL_MS)
        resp.status = PlanningStatus.SUCCESS
        return resp
]]>
        </CodeFile>

