<![CDATA[
"""
Motion Control and Collision Avoidance.

Traces:
- CMP--8 Motion Control and Collision Avoidance
- DAT--6 Motion Primitive Specification
"""

from __future__ import annotations

from typing import List, Optional

from waveshare.motor import Motor

from . import config
from .grid_map import CellIndex
from .sensor_layer import FilteredSensorData
from .types import PathExecutionStatus
from .utils import clamp


class MotionCommand:
    """High-level motion command from Mission Control (MC_MotionCommand, CMP--1/8)."""

    def __init__(self, path: List[CellIndex], speed_profile: str):
        self.path = path
        self.speed_profile = speed_profile  # "EXPLORE", "RETURN", "SECOND_RUN"


class MotionController:
    """CMP--8 implementation (simplified)."""

    def __init__(self, motor: Motor):
        self.motor = motor

        self._mode = "NORMAL"  # NORMAL / AVOIDANCE / EMERGENCY_STOPPED
        self._current_cmd: Optional[MotionCommand] = None

        self._path_index = 0  # next waypoint index
        self._left_speed = 0
        self._right_speed = 0

        self.path_status: str = PathExecutionStatus.RUNNING

    # ==== Command handling =================================================

    def set_motion_command(self, cmd: MotionCommand) -> None:
        """Accept new high-level motion command (CMP--8 Execution)."""
        self._current_cmd = cmd
        self._mode = "NORMAL"
        self._path_index = 0
        self.path_status = PathExecutionStatus.RUNNING

    # ==== Per-loop update ==================================================

    def update(self, filtered: FilteredSensorData, current_cell: CellIndex) -> None:
        """Per control-loop update (CMP--8 Execution)."""
        # 1) Emergency-stop check
        if self._mode != "EMERGENCY_STOPPED":
            if filtered.ultrasonic_valid and filtered.ultrasonic_cm < config.EMERGENCY_STOP_THRESHOLD_CM:
                # Emergency stop (CMP--8 Failures)
                self._left_speed = 0
                self._right_speed = 0
                self.motor.stop()
                self._mode = "EMERGENCY_STOPPED"
                self.path_status = PathExecutionStatus.COLLISION_ABORTED
                return

        # If emergency stopped, remain so until new command is set.
        if self._mode == "EMERGENCY_STOPPED":
            self.motor.stop()
            return

        # 4) Execute simple cell-center primitive following path
        if not self._current_cmd or not self._current_cmd.path:
            # Nothing to do
            self._set_speeds(0, 0)
            return

        # Check if we reached last waypoint
        if self._path_index >= len(self._current_cmd.path):
            self._set_speeds(0, 0)
            self.path_status = PathExecutionStatus.SUCCESS_REACHED_GOAL
            return

        target_cell = self._current_cmd.path[self._path_index]
        if current_cell == target_cell:
            # Advance to next waypoint
            self._path_index += 1
            if self._path_index >= len(self._current_cmd.path):
                self._set_speeds(0, 0)
                self.path_status = PathExecutionStatus.SUCCESS_REACHED_GOAL
                return
            target_cell = self._current_cmd.path[self._path_index]

        # For this simple example, we approximate: always move forward with
        # given speed profile; pose estimator is updated externally.
        duty = self._profile_to_speed(self._current_cmd.speed_profile)
        self._set_speeds(duty, duty)

    # ==== Internal helpers =================================================

    def _profile_to_speed(self, profile: str) -> int:
        if profile == "SECOND_RUN":
            return config.SECOND_RUN_SPEED_DUTY
        if profile == "RETURN":
            return config.RETURN_SPEED_DUTY
        return config.EXPLORATION_SPEED_DUTY

    def _set_speeds(self, left: int, right: int) -> None:
        # Rate limiting per CMP--8 Invariants.
        left = int(clamp(left, -config.MAX_SPEED_DUTY, config.MAX_SPEED_DUTY))
        right = int(clamp(right, -config.MAX_SPEED_DUTY, config.MAX_SPEED_DUTY))

        dl = left - self._left_speed
        dr = right - self._right_speed
        if abs(dl) > config.MAX_ACCEL_PER_CYCLE:
            left = self._left_speed + config.MAX_ACCEL_PER_CYCLE * (1 if dl > 0 else -1)
        if abs(dr) > config.MAX_ACCEL_PER_CYCLE:
            right = self._right_speed + config.MAX_ACCEL_PER_CYCLE * (1 if dr > 0 else -1)

        self._left_speed = left
        self._right_speed = right
        self.motor.set(left, right)
]]>
        </CodeFile>

