<![CDATA[
"""
Sensor Abstraction and Filtering Layer.

Traces:
- CMP--7 Sensor Abstraction and Filtering Layer
- DAT--5 Sensor Filtering and Consistency Parameters
"""

from __future__ import annotations

from typing import List

from waveshare.ultrasonic_sensor import UltrasonicSensor
from waveshare.infrared import Infrared

from . import config
from .utils import moving_average, bool_majority


class FilteredSensorData:
    """SAL_FilteredSensorData (CMP--7, CMP--6, CMP--8)."""

    def __init__(self):
        self.ultrasonic_cm: float = 1000.0
        self.ultrasonic_valid: bool = False
        self.ir_left: bool = False
        self.ir_right: bool = False
        self.timestamp_ms: int = 0


class SensorLayer:
    """Implementation of CMP--7."""

    def __init__(self, time_ms_provider):
        self._time_ms = time_ms_provider

        self._ultra = UltrasonicSensor()
        self._ir = Infrared()

        self._ultra_buf: List[float] = []
        self._ir_left_buf: List[bool] = []
        self._ir_right_buf: List[bool] = []

        self.filtered = FilteredSensorData()

        self.sensor_available: bool = False  # SensorAvailabilityStatus

        self._ultra_seen_valid = False
        self._ir_seen_valid = False

    def _read_ultrasonic_raw(self) -> float:
        try:
            d = float(self._ultra.distance())
        except Exception:
            return -1.0
        return d

    def _read_ir_raw(self):
        try:
            left = bool(self._ir.dsl())
            right = bool(self._ir.dsr())
        except Exception:
            left = False
            right = False
        return left, right

    def update(self) -> None:
        """Execute one SAL update per control loop (CMP--7 Execution)."""
        now = self._time_ms()

        # 1) Sample raw sensors
        raw_d = self._read_ultrasonic_raw()
        raw_left, raw_right = self._read_ir_raw()

        # 2) Sanitize invalid ultrasonic values (CMP--7 Execution step 2)
        if raw_d <= 0 or raw_d != raw_d:  # NaN check
            ultra_valid = False
            raw_d = 1000.0
        else:
            ultra_valid = True

        self._ultra_buf.append(raw_d)
        if len(self._ultra_buf) > config.ULTRASONIC_WINDOW:
            self._ultra_buf.pop(0)

        self._ir_left_buf.append(raw_left)
        if len(self._ir_left_buf) > config.IR_WINDOW:
            self._ir_left_buf.pop(0)

        self._ir_right_buf.append(raw_right)
        if len(self._ir_right_buf) > config.IR_WINDOW:
            self._ir_right_buf.pop(0)

        # 3) Compute filtered values (moving average / majority)
        filt_d = moving_average(self._ultra_buf)
        filt_left = bool_majority(self._ir_left_buf)
        filt_right = bool_majority(self._ir_right_buf)

        self.filtered.ultrasonic_cm = filt_d
        self.filtered.ultrasonic_valid = ultra_valid
        self.filtered.ir_left = filt_left
        self.filtered.ir_right = filt_right
        self.filtered.timestamp_ms = now

        # 5) Update SensorAvailabilityStatus (CMP--7 Execution step 5)
        if ultra_valid:
            self._ultra_seen_valid = True
        if True:  # IR "valid" is always; we just treat as data
            self._ir_seen_valid = True

        self.sensor_available = self._ultra_seen_valid and self._ir_seen_valid
]]>
        </CodeFile>

