"""
Common enums / simple data structures.

Traces:
- Grid map data types from DAT--1
- Mission-level result enums from DAT--1
"""

from __future__ import annotations

from typing import List, Tuple, Optional


# ===== Grid states (DAT--1) ===============================================

class CellState:
    """CMP--3, DAT--1: enum CellState { CELL_UNKNOWN, CELL_FREE, CELL_BLOCKED }."""
    CELL_UNKNOWN = 0
    CELL_FREE = 1
    CELL_BLOCKED = 2


class WallState:
    """CMP--3, DAT--1: enum WallState { WALL_UNKNOWN, WALL_PRESENT, WALL_ABSENT }."""
    WALL_UNKNOWN = 0
    WALL_PRESENT = 1
    WALL_ABSENT = 2


# Mission and run status enums (DAT--1) ------------------------------------

class ReturnToStartStatusEnum:
    """DAT--1: ReturnToStartStatusEnum."""
    RETURN_NOT_EXECUTED = 0
    RETURN_SUCCESS = 1
    RETURN_FAILURE = 2


class SecondRunStatusEnum:
    """DAT--1: SecondRunStatusEnum.

    Maps to MC_SecondRunStatusOutput in CMP--1 / FSM--1.
    """
    SECOND_RUN_NOT_EXECUTED = 0
    SECOND_RUN_SUCCESS = 1
    SECOND_RUN_FAILURE = 2


# Mission Control states (FSM--1) ------------------------------------------

class MissionState:
    """Mission Control top-level states (FSM--1, CMP--1)."""
    IDLE = "IDLE"
    EXPLORE = "EXPLORE"
    RETURN_TO_START = "RETURN_TO_START"
    SECOND_RUN = "SECOND_RUN"
    COMPLETED = "COMPLETED"


# Path planning status -----------------------------------------------------

class PlanningStatus:
    """CMP--4: PL_PathPlanningResponse.status."""
    SUCCESS = "SUCCESS"
    FAILURE_NO_PATH = "FAILURE_NO_PATH"
    FAILURE_TIMEOUT = "FAILURE_TIMEOUT"
    INVALID_GOAL = "INVALID_GOAL"


# Path execution status (CMP--8) ------------------------------------------

class PathExecutionStatus:
    """Status enums communicated between motion control and mission control."""
    RUNNING = "RUNNING"
    REACHED_START = "REACHED_START"
    PATH_INVALID = "PATH_INVALID"
    COLLISION_ABORTED = "COLLISION_ABORTED"
    SUCCESS_REACHED_GOAL = "SUCCESS_REACHED_GOAL"
    FAILURE_COLLISION = "FAILURE_COLLISION"
    FAILURE_NO_PATH = "FAILURE_NO_PATH"


# Misc simple types --------------------------------------------------------

CellIndex = Tuple[int, int]  # (row, col)
Path = List[CellIndex]


class Pose:
    """Discrete pose (CMP--9)."""

    def __init__(self, row: int = 0, col: int = 0, heading_idx: int = 0):
        self.row = row
        self.col = col
        # 0:NORTH, 1:EAST, 2:SOUTH, 3:WEST
        self.heading_idx = heading_idx
        # Continuous approximations (not strictly required for discrete map)
        self.x = 0.0
        self.y = 0.0
        self.theta = 0.0

    def cell(self) -> CellIndex:
        return (self.row, self.col)

    def copy(self) -> "Pose":
        p = Pose(self.row, self.col, self.heading_idx)
        p.x = self.x
        p.y = self.y
        p.theta = self.theta
        return p
