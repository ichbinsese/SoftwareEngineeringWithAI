<![CDATA[
"""
Goal Region Identification and Selection.

Traces:
- CMP--5 Goal Region Identification and Selection
"""

from __future__ import annotations

from typing import List, Tuple, Optional

from .grid_map import GridMap, CellIndex
from .planner import Planner, PathPlanningRequest
from .types import CellState, PlanningStatus


class GoalRegionSelector:
    """CMP--5 implementation."""

    def __init__(self, grid: GridMap, planner: Planner):
        self.grid = grid
        self.planner = planner
        self.selected_region: Optional[List[CellIndex]] = None
        self.selected_goal_cell: Optional[CellIndex] = None

    def _enumerate_candidate_regions(self) -> List[List[CellIndex]]:
        """Enumerate all 2x2 all-FREE regions (CMP--5 Execution step 2)."""
        regions: List[List[CellIndex]] = []
        for r in range(self.grid.rows - 1):
            for c in range(self.grid.cols - 1):
                cells = [(r, c), (r + 1, c), (r, c + 1), (r + 1, c + 1)]
                if all(self.grid.get_cell_state(cr, cc) == CellState.CELL_FREE for cr, cc in cells):
                    regions.append(cells)
        return regions

    def select_region(self) -> None:
        """Perform full goal region selection once (CMP--5 Execution)."""
        start = self.grid.start_cell
        candidates = self._enumerate_candidate_regions()
        best_region: Optional[List[CellIndex]] = None
        best_cost: Optional[float] = None
        best_goal: Optional[CellIndex] = None

        for region in candidates:
            # Request cost info (CMP--5 Execution step 3).
            # We'll pick minimal cost among cells in region.
            region_best_cost: Optional[float] = None
            region_best_cell: Optional[CellIndex] = None

            for cell in region:
                req = PathPlanningRequest(request_id=0, mode="SECOND_RUN", start=start, goals=[cell])
                resp = self.planner.plan(req)
                if resp.status != PlanningStatus.SUCCESS:
                    continue
                if region_best_cost is None or resp.total_cost < region_best_cost:
                    region_best_cost = resp.total_cost
                    region_best_cell = cell

            if region_best_cost is None:
                # Region unreachable
                continue

            if best_cost is None or region_best_cost < best_cost:
                best_cost = region_best_cost
                best_region = region
                best_goal = region_best_cell

        self.selected_region = best_region
        self.selected_goal_cell = best_goal
]]>
