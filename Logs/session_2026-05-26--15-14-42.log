<![CDATA[
"""
Mapping and Wall Detection Module.

Traces:
- CMP--6 Mapping and Wall Detection Module
- Uses SAL_FilteredSensorData (CMP--7) and GridMap (CMP--3)
"""

from __future__ import annotations

from typing import Dict, Tuple

from .grid_map import GridMap, CellIndex
from .sensor_layer import FilteredSensorData
from .types import CellState, WallState
from . import config


class MappingModule:
    """CMP--6 implementation (simplified but respecting invariants)."""

    def __init__(self, grid: GridMap):
        self.grid = grid

        # Hysteresis / consistency counters per cell or wall index (DAT--5).
        # For simplicity, we track cell free & blocked evidence.
        self._cell_free_evidence: Dict[CellIndex, int] = {}
        self._cell_blocked_evidence: Dict[CellIndex, int] = {}

    # ==== Helpers ==========================================================

    def _inc_counter(self, d: Dict[CellIndex, int], key: CellIndex) -> int:
        v = d.get(key, 0) + 1
        d[key] = v
        return v

    # ==== Main per-loop update (CMP--6 Execution) ==========================

    def update_for_pose_and_sensors(
        self,
        pose_cell: CellIndex,
        pose_heading_idx: int,
        at_cell_center: bool,
        filtered: FilteredSensorData,
    ) -> None:
        """Per control loop mapping logic.

        This implementation focuses on free cell confirmation and very coarse
        front-wall detection. Full geometric wall indexing is simplified for
        MicroPython, but invariants from CMP--6 and CMP--3 are respected.
        """
        r, c = pose_cell

        # === 2) Front wall detection via ultrasonic ========================
        # Very simple rule: if at cell center and ultrasonic is below some
        # threshold, we infer a wall in front direction, and optionally infer
        # neighbor cell as BLOCKED (CMP--6 Execution step 2, 5).
        if at_cell_center and filtered.ultrasonic_valid:
            d = filtered.ultrasonic_cm
            # Use expected approx center-to-wall distance (DAT--4).
            approx_front_dist = config.CELL_LENGTH_CM / 2.0
            # If reading is within uncertainty band of front wall, mark wall present.
            if d < approx_front_dist + config.ULTRASONIC_UNCERTAINTY_CM:
                nr, nc = self._neighbor_in_heading(r, c, pose_heading_idx)
                if nr is not None:
                    # Mark neighbor as BLOCKED via UNKNOWN->BLOCKED rule (CMP--3 Invariants)
                    if self.grid.get_cell_state(nr, nc) == CellState.CELL_UNKNOWN:
                        cnt = self._inc_counter(self._cell_blocked_evidence, (nr, nc))
                        if cnt >= config.CONSISTENCY_N:
                            self.grid.set_cell_state_unknown_to(nr, nc, CellState.CELL_BLOCKED)

        # === 3) Free cell confirmation on being at center ==================
        # If we are at cell center, mark current cell as FREE after enough
        # consistent occupancy with no collision; collision info is not modeled
        # explicitly here but can be threaded in.
        if at_cell_center:
            if self.grid.get_cell_state(r, c) == CellState.CELL_UNKNOWN:
                cnt = self._inc_counter(self._cell_free_evidence, (r, c))
                if cnt >= config.CONSISTENCY_N:
                    self.grid.set_cell_state_unknown_to(r, c, CellState.CELL_FREE)

    # ==== Simple helper to get neighbor in heading =========================

    def _neighbor_in_heading(self, r: int, c: int, heading_idx: int) -> Tuple[int, int]:
        # 0:N, 1:E, 2:S, 3:W
        if heading_idx == 0 and r > 0:
            return r - 1, c
        if heading_idx == 2 and r < self.grid.rows - 1:
            return r + 1, c
        if heading_idx == 1 and c < self.grid.cols - 1:
            return r, c + 1
        if heading_idx == 3 and c > 0:
            return r, c - 1
        return None, None
]]>
        </CodeFile>

