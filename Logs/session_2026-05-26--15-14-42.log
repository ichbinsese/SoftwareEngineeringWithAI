<![CDATA[
"""
Frontier Generation and Exploration Target Selection.

Traces:
- CMP--2 implementation
- DAT--3 (time-aware planning)
"""

from __future__ import annotations

from typing import List, Optional, Tuple

from . import config
from .grid_map import GridMap, CellIndex
from .types import CellState


class FrontierTarget:
    """Represents FGM_SelectedTarget (CMP--2)."""

    def __init__(self, cell: Optional[CellIndex], est_travel_ms: int = 0):
        self.cell = cell
        self.estimated_travel_ms = est_travel_ms
        self.estimated_info_gain = 0
        self.heuristic_value = 0.0


class FrontierGenerator:
    """CMP--2 implementation."""

    def __init__(self, grid: GridMap):
        self.grid = grid
        self._cached_frontiers: List[CellIndex] = []
        self._cache_valid = False

    # ==== Frontier recomputation (CMP--2, Execution) =======================

    def recompute_frontiers(self) -> List[CellIndex]:
        """Compute set of frontier cells.

        Frontier = UNKNOWN cells that have at least one FREE 4-neighbor.
        """
        rows = self.grid.rows
        cols = self.grid.cols
        res: List[CellIndex] = []
        for r in range(rows):
            for c in range(cols):
                if self.grid.get_cell_state(r, c) != CellState.CELL_UNKNOWN:
                    continue
                # Check for FREE neighbor
                for nr, nc in self.grid.neighbors4(r, c):
                    if self.grid.get_cell_state(nr, nc) == CellState.CELL_FREE:
                        res.append((r, c))
                        break
        self._cached_frontiers = res
        self._cache_valid = True
        return res

    def invalidate_cache(self) -> None:
        self._cache_valid = False

    def get_frontiers(self) -> List[CellIndex]:
        if not self._cache_valid:
            return self.recompute_frontiers()
        return list(self._cached_frontiers)

    # ==== Target selection (CMP--2) ========================================

    def select_target(
        self,
        current_cell: CellIndex,
        remaining_time_ms: int,
        nominal_cell_traversal_ms: int = config.NOMINAL_CELL_TRAVERSAL_MS,
    ) -> FrontierTarget:
        """Select best feasible frontier cell.

        Very simple heuristic:
        - Use Manhattan distance as approximate path length.
        - Check time feasibility per DAT--3.
        - Choose closest feasible candidate.
        """
        frontiers = self.get_frontiers()
        if not frontiers:
            return FrontierTarget(None)

        best: Optional[Tuple[CellIndex, int]] = None

        for fr in frontiers:
            d_cells = abs(fr[0] - current_cell[0]) + abs(fr[1] - current_cell[1])
            est_travel = d_cells * nominal_cell_traversal_ms
            est_mapping_overhead = nominal_cell_traversal_ms

            if est_travel + est_mapping_overhead > remaining_time_ms:
                # Time-aware planning filter (DAT--3)
                continue

            if best is None or est_travel < best[1]:
                best = (fr, est_travel)

        if best is None:
            # No feasible candidates (CMP--2 Failures: Time-limit constraint)
            return FrontierTarget(None)

        tgt = FrontierTarget(best[0], best[1])
        tgt.heuristic_value = 1.0 / (1.0 + best[1])
        return tgt
]]>
