"""
Utility helpers.

Traces:
- Used across multiple components to keep code compact.
"""

from __future__ import annotations

from typing import List, Iterable, TypeVar

T = TypeVar("T")


def clamp(val: float, lo: float, hi: float) -> float:
    if val < lo:
        return lo
    if val > hi:
        return hi
    return val


def moving_average(values: List[float]) -> float:
    if not values:
        return 0.0
    return sum(values) / float(len(values))


def bool_majority(values: Iterable[bool]) -> bool:
    """Return True if majority of values are True."""
    vs = list(values)
    if not vs:
        return False
    return sum(1 for v in vs if v) >= (len(vs) + 1) // 2
