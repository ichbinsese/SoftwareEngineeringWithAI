"""
Simple event queue.

Traces:
- Event Queue spec from DAT--7
- CMP--1, CMP--11: ExplorationEvents
"""

from __future__ import annotations

from typing import Optional, Any, List


class EventType:
    EXPLORATION_COMPLETED = "EXPLORATION_COMPLETED"
    EXPLORATION_TIMEOUT = "EXPLORATION_TIMEOUT"
    PATH_INVALIDATED = "PATH_INVALIDATED"
    RETURN_COMPLETED = "RETURN_COMPLETED"
    SECOND_RUN_COMPLETED = "SECOND_RUN_COMPLETED"


class Event:
    """DAT--7: struct Event { EventType type; uint32_t timestamp; EventPayload payload; }"""

    def __init__(self, ev_type: str, timestamp_ms: int, payload: Any = None):
        self.type = ev_type
        self.timestamp_ms = timestamp_ms
        self.payload = payload


class EventQueue:
    """Circular buffer of fixed size (DAT--7)."""

    def __init__(self, capacity: int = 16):
        self._capacity = capacity
        self._buf: List[Optional[Event]] = [None] * capacity
        self._head = 0
        self._tail = 0
        self._size = 0

    def enqueue(self, ev: Event) -> None:
        if self._size == self._capacity:
            # Overwrite oldest event; design does not specify dropping strategy, but
            # EXPLORATION_COMPLETED / TIMEOUT are emitted only once, so risk is small.
            self._head = (self._head + 1) % self._capacity
            self._size -= 1
        self._buf[self._tail] = ev
        self._tail = (self._tail + 1) % self._capacity
        self._size += 1

    def dequeue(self) -> Optional[Event]:
        if self._size == 0:
            return None
        ev = self._buf[self._head]
        self._buf[self._head] = None
        self._head = (self._head + 1) % self._capacity
        self._size -= 1
        return ev

    def drain(self) -> list:
        out = []
        while True:
            ev = self.dequeue()
            if ev is None:
                break
            out.append(ev)
        return out
]]>
