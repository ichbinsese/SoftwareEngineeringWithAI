"""
Exploration Status and Time Limit Module.

Traces:
- CMP--11 Exploration Status and Time Limit Module
"""

from __future__ import annotations

from . import config
from .grid_map import GridMap
from .events import EventQueue, Event, EventType


class ExplorationStatus:
    """CMP--11 implementation."""

    def __init__(self, grid: GridMap, event_queue: EventQueue, time_ms_provider):
        self.grid = grid
        self.events = event_queue
        self._time_ms = time_ms_provider

        self._explore_start_ms: int = 0
        self._timeout_emitted = False
        self._completed_emitted = False

        self.elapsed_ms: int = 0
        self.remaining_ms: int = config.EXPLORATION_TIME_LIMIT_MS

    def start_exploration(self) -> None:
        self._explore_start_ms = self._time_ms()
        self._timeout_emitted = False
        self._completed_emitted = False

    def update(self) -> None:
        """Each control loop (CMP--11 Execution)."""
        if self._explore_start_ms == 0:
            return

        now = self._time_ms()
        self.elapsed_ms = now - self._explore_start_ms
        if self.elapsed_ms < 0:
            self.elapsed_ms = 0
        self.remaining_ms = config.EXPLORATION_TIME_LIMIT_MS - self.elapsed_ms
        if self.remaining_ms < 0:
            self.remaining_ms = 0

        # 2) Timeout
        if not self._timeout_emitted and self.elapsed_ms >= config.EXPLORATION_TIME_LIMIT_MS:
            self._timeout_emitted = True
            self.events.enqueue(Event(EventType.EXPLORATION_TIMEOUT, now))

        # 3) Map completeness
        if not self._completed_emitted and self.grid.map_complete:
            self._completed_emitted = True
            self.events.enqueue(Event(EventType.EXPLORATION_COMPLETED, now))
