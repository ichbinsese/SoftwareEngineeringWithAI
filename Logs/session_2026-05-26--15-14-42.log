<![CDATA[
"""
Scheduler and Initialization.

Traces:
- CMP--10 Scheduler and Initialization
"""

from __future__ import annotations

import time

from waveshare.motor import Motor

from . import config
from .grid_map import GridMap
from .frontier import FrontierGenerator
from .planner import Planner
from .goal_region import GoalRegionSelector
from .sensor_layer import SensorLayer
from .mapping import MappingModule
from .pose import PoseEstimator
from .motion_control import MotionController
from .exploration_status import ExplorationStatus
from .events import EventQueue
from .mission_control import MissionControl


class Scheduler:
    """CMP--10 implementation with a blocking main loop."""

    def __init__(self):
        self._start_time = time.ticks_ms()

        self.grid = GridMap()
        self.grid.init_request(start_cell=(0, 0))

        self.event_queue = EventQueue()

        self.pose = PoseEstimator()
        self.motor = Motor()
        self.motion = MotionController(self.motor)

        self.sensors = SensorLayer(self.time_ms)
        self.mapping = MappingModule(self.grid)
        self.frontier = FrontierGenerator(self.grid)
        self.planner = Planner(self.grid)
        self.goal_region = GoalRegionSelector(self.grid, self.planner)
        self.expl_status = ExplorationStatus(self.grid, self.event_queue, self.time_ms)

        self.mission = MissionControl(
            grid=self.grid,
            frontier=self.frontier,
            planner=self.planner,
            goal_region=self.goal_region,
            exploration_status=self.expl_status,
            motion=self.motion,
            pose=self.pose,
            sensors=self.sensors,
            events=self.event_queue,
            time_ms_provider=self.time_ms,
        )

        # After initialization, raise INIT_COMPLETED
        self.mission.set_init_completed()

    def time_ms(self) -> int:
        return time.ticks_diff(time.ticks_ms(), self._start_time)

    def run(self) -> None:
        """Blocking control loop; called from main.py."""
        period_ms = int(config.CONTROL_PERIOD_MS)
        while True:
            loop_start = time.ticks_ms()

            # 1) Scheduler tick is implicit here (CMP--10 Execution).
            # 2) Acquire sensor readings
            self.sensors.update()

            # 3) Update mapping and grid map
            self.mapping.update_for_pose_and_sensors(
                pose_cell=self.pose.pose.cell(),
                pose_heading_idx=self.pose.pose.heading_idx,
                at_cell_center=self.pose.at_cell_center,
                filtered=self.sensors.filtered,
            )

            # 4) Exploration status
            self.expl_status.update()

            # 5) Mission control
            self.mission.update()

            # 6) Motion control
            self.motion.update(self.sensors.filtered, self.pose.pose.cell())

            # Sleep to maintain control period
            elapsed = time.ticks_diff(time.ticks_ms(), loop_start)
            remaining = period_ms - elapsed
            if remaining > 0:
                time.sleep_ms(remaining)
]]>
