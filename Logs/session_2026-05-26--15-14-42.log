<![CDATA[
"""
Mission Control State Machine (CMP--1, FSM--1).
"""

from __future__ import annotations

from typing import Optional, List

from .types import MissionState, SecondRunStatusEnum, PathExecutionStatus, PlanningStatus
from .events import EventQueue, EventType, Event
from .grid_map import GridMap, CellIndex
from .frontier import FrontierGenerator, FrontierTarget
from .planner import Planner, PathPlanningRequest
from .goal_region import GoalRegionSelector
from .exploration_status import ExplorationStatus
from .motion_control import MotionCommand, MotionController
from .sensor_layer import SensorLayer
from .pose import PoseEstimator
from . import config


class MissionControl:
    """Implementation of CMP--1 and FSM--1."""

    def __init__(
        self,
        grid: GridMap,
        frontier: FrontierGenerator,
        planner: Planner,
        goal_region: GoalRegionSelector,
        exploration_status: ExplorationStatus,
        motion: MotionController,
        pose: PoseEstimator,
        sensors: SensorLayer,
        events: EventQueue,
        time_ms_provider,
    ):
        self.grid = grid
        self.frontier = frontier
        self.planner = planner
        self.goal_region = goal_region
        self.expl_status = exploration_status
        self.motion = motion
        self.pose = pose
        self.sensors = sensors
        self.events = events
        self._time_ms = time_ms_provider

        self.state: str = MissionState.IDLE
        self.second_run_status: int = SecondRunStatusEnum.SECOND_RUN_NOT_EXECUTED

        self._init_completed: bool = False  # from scheduler
        self._have_goal_region: bool = False

    # ===== External control flags =========================================

    def set_init_completed(self) -> None:
        self._init_completed = True

    # ===== Per-loop update =================================================

    def update(self) -> None:
        """One iteration of mission logic per control loop (CMP--1 Execution)."""
        # Drain relevant events
        events = self.events.drain()

        if self.state == MissionState.IDLE:
            self._state_idle(events)
        elif self.state == MissionState.EXPLORE:
            self._state_explore(events)
        elif self.state == MissionState.RETURN_TO_START:
            self._state_return_to_start(events)
        elif self.state == MissionState.SECOND_RUN:
            self._state_second_run(events)
        elif self.state == MissionState.COMPLETED:
            self._state_completed(events)

    # ===== State handlers (FSM--1) ========================================

    def _state_idle(self, events: list) -> None:
        # FSM--1 IDLE state action: keep motors stopped, monitor INIT_COMPLETED & SensorAvailabilityStatus.
        self.motion.set_motion_command(MotionCommand([], "EXPLORE"))  # results in stop
        # Check transition IDLE -> EXPLORE (FSM--1)
        if self._init_completed and self.sensors.sensor_available:
            # TransitionAction: start exploration timers/modules.
            self.expl_status.start_exploration()
            self.state = MissionState.EXPLORE

    def _state_explore(self, events: list) -> None:
        # Process exploration events to decide transition to RETURN_TO_START.
        exploration_completed = False
        exploration_timeout = False
        for ev in events:
            if ev.type == EventType.EXPLORATION_COMPLETED:
                exploration_completed = True
            elif ev.type == EventType.EXPLORATION_TIMEOUT:
                exploration_timeout = True

        if exploration_completed or exploration_timeout:
            # Transition EXPLORE->RETURN_TO_START (FSM--1).
            self.state = MissionState.RETURN_TO_START
            return

        # StateAction (FSM--1): frontier selection + path planning + motion command.
        current_cell: CellIndex = self.pose.pose.cell()
        remaining_ms = self.expl_status.remaining_ms
        target: FrontierTarget = self.frontier.select_target(current_cell, remaining_ms)
        if target.cell is None:
            # No frontier; rely on EXPLORATION_COMPLETED event.
            self.motion.set_motion_command(MotionCommand([], "EXPLORE"))
            return

        # Path planning request
        req = PathPlanningRequest(
            request_id=1,
            mode="EXPLORE",
            start=current_cell,
            goals=[target.cell],
        )
        resp = self.planner.plan(req)
        if resp.status != PlanningStatus.SUCCESS or not resp.path:
            # No path; rely on exploration status / timeout events.
            self.motion.set_motion_command(MotionCommand([], "EXPLORE"))
            return

        # Issue motion command (CMP--1 Purpose, MC_MotionCommand)
        cmd = MotionCommand(resp.path, "EXPLORE")
        self.motion.set_motion_command(cmd)

    def _state_return_to_start(self, events: list) -> None:
        # On entry, if path not yet started, request path to start.
        # For simplicity, we check if motion has no command or already completed.
        if self.motion.path_status in (
            PathExecutionStatus.SUCCESS_REACHED_GOAL,
            PathExecutionStatus.COLLISION_ABORTED,
            PathExecutionStatus.FAILURE_NO_PATH,
        ) or not self.motion._current_cmd:
            current_cell: CellIndex = self.pose.pose.cell()
            start_cell = self.grid.start_cell
            req = PathPlanningRequest(
                request_id=2, mode="RETURN_TO_START", start=current_cell, goals=[start_cell]
            )
            resp = self.planner.plan(req)
            if resp.status != PlanningStatus.SUCCESS or not resp.path:
                # Planning failure in RETURN_TO_START (CMP--1 Failures)
                self.state = MissionState.COMPLETED
                self.second_run_status = SecondRunStatusEnum.SECOND_RUN_FAILURE
                return
            cmd = MotionCommand(resp.path, "RETURN")
            self.motion.set_motion_command(cmd)

        # Monitor path execution status
        if self.motion.path_status == PathExecutionStatus.SUCCESS_REACHED_GOAL:
            # Evaluate whether we can do second run
            # Select goal region if not done
            if not self._have_goal_region:
                self.goal_region.select_region()
                self._have_goal_region = self.goal_region.selected_region is not None
            if self._have_goal_region:
                self.state = MissionState.SECOND_RUN
                self.second_run_status = SecondRunStatusEnum.SECOND_RUN_NOT_EXECUTED
            else:
                # No goal region found; mission completed
                self.state = MissionState.COMPLETED
                self.second_run_status = SecondRunStatusEnum.SECOND_RUN_FAILURE

        elif self.motion.path_status == PathExecutionStatus.COLLISION_ABORTED:
            # RETURN_TO_START failure => mission ends (CMP--1 Failures)
            self.state = MissionState.COMPLETED
            self.second_run_status = SecondRunStatusEnum.SECOND_RUN_FAILURE

    def _state_second_run(self, events: list) -> None:
        # On entry or when command completes, plan fastest path to goal region
        if (
            self.motion.path_status
            in (
                PathExecutionStatus.SUCCESS_REACHED_GOAL,
                PathExecutionStatus.COLLISION_ABORTED,
                PathExecutionStatus.FAILURE_NO_PATH,
            )
            or not self.motion._current_cmd
        ):
            if not self._have_goal_region or self.goal_region.selected_goal_cell is None:
                self.state = MissionState.COMPLETED
                self.second_run_status = SecondRunStatusEnum.SECOND_RUN_FAILURE
                return

            start_cell = self.grid.start_cell
            goal_cell = self.goal_region.selected_goal_cell
            req = PathPlanningRequest(
                request_id=3,
                mode="SECOND_RUN",
                start=start_cell,
                goals=[goal_cell],
            )
            resp = self.planner.plan(req)
            if resp.status != PlanningStatus.SUCCESS or not resp.path:
                self.state = MissionState.COMPLETED
                self.second_run_status = SecondRunStatusEnum.SECOND_RUN_FAILURE
                return
            cmd = MotionCommand(resp.path, "SECOND_RUN")
            self.motion.set_motion_command(cmd)
            self.second_run_status = SecondRunStatusEnum.SECOND_RUN_NOT_EXECUTED

        # Monitor path execution
        if self.motion.path_status == PathExecutionStatus.SUCCESS_REACHED_GOAL:
            self.state = MissionState.COMPLETED
            self.second_run_status = SecondRunStatusEnum.SECOND_RUN_SUCCESS
        elif self.motion.path_status == PathExecutionStatus.COLLISION_ABORTED:
            self.state = MissionState.COMPLETED
            self.second_run_status = SecondRunStatusEnum.SECOND_RUN_FAILURE

    def _state_completed(self, events: list) -> None:
        # COMPLETED: cease issuing new commands (FSM--1).
        self.motion.set_motion_command(MotionCommand([], "EXPLORE"))
        # Mission remains in this state; status latched in self.second_run_status.
        return
