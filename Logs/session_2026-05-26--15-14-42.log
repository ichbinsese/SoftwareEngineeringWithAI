<![CDATA[
"""
Grid Map Module implementation.

Traces:
- CMP--3 Grid Map Module
- DAT--1 grid structures
"""

from __future__ import annotations

from typing import Tuple, List

from .types import CellState, WallState
from . import config


CellIndex = Tuple[int, int]


class GridMap:
    """CMP--3 implementation for a 4x8 grid map."""

    def __init__(self):
        self.rows = config.CELL_ROWS
        self.cols = config.CELL_COLS

        # DAT--1: CellState cells[4][8]
        self.cells = [
            [CellState.CELL_UNKNOWN for _ in range(self.cols)]
            for _ in range(self.rows)
        ]

        # DAT--1: Horizontal walls hWalls[3][8]: between (row, col) and (row+1, col)
        self.h_walls = [
            [WallState.WALL_UNKNOWN for _ in range(self.cols)]
            for _ in range(self.rows - 1)
        ]

        # DAT--1: Vertical walls vWalls[4][7]: between (row, col) and (row, col+1)
        self.v_walls = [
            [WallState.WALL_UNKNOWN for _ in range(self.cols - 1)]
            for _ in range(self.rows)
        ]

        # For completeness tracking (CMP--3 execution)
        self._unknown_cells = self.rows * self.cols
        # Horizontal walls: (rows-1)*cols, vertical: rows*(cols-1)
        self._unknown_walls = (self.rows - 1) * self.cols + self.rows * (self.cols - 1)

        # Map completeness flag (CMP--3, CMP--11)
        self.map_complete = False

        # Start cell coordinate, set during init_request
        self.start_cell: CellIndex = (0, 0)

    # ===== Helpers =========================================================

    def _check_cell_index(self, row: int, col: int) -> bool:
        return 0 <= row < self.rows and 0 <= col < self.cols

    # ===== Initialization (CMP--3 Execution, Init_Request) =================

    def init_request(self, start_cell: CellIndex = (0, 0)) -> None:
        """Initialize map to UNKNOWN and designate start cell as FREE.

        Traces: CMP--3 Execution, "Map initialization at startup".
        """
        self.start_cell = start_cell

        for r in range(self.rows):
            for c in range(self.cols):
                self.cells[r][c] = CellState.CELL_UNKNOWN

        for r in range(self.rows - 1):
            for c in range(self.cols):
                self.h_walls[r][c] = WallState.WALL_UNKNOWN

        for r in range(self.rows):
            for c in range(self.cols - 1):
                self.v_walls[r][c] = WallState.WALL_UNKNOWN

        self._unknown_cells = self.rows * self.cols
        self._unknown_walls = (self.rows - 1) * self.cols + self.rows * (self.cols - 1)
        self.map_complete = False

        # Start cell is FREE (CMP--3 Execution step 3)
        sr, sc = self.start_cell
        if self._check_cell_index(sr, sc):
            if self.cells[sr][sc] == CellState.CELL_UNKNOWN:
                self.cells[sr][sc] = CellState.CELL_FREE
                self._unknown_cells -= 1
        self._update_completeness_flag()

    # ===== Query APIs (CMP--3, CMP--2, CMP--4) ============================

    def get_cell_state(self, row: int, col: int) -> int:
        if not self._check_cell_index(row, col):
            return CellState.CELL_BLOCKED
        return self.cells[row][col]

    def set_cell_state_unknown_to(self, row: int, col: int, new_state: int) -> bool:
        """Set cell classification if and only if UNKNOWN -> FREE/BLOCKED.

        Traces:
        - CMP--3 Execution 4) Apply explicit MM_MapUpdateRequest.
        - Invariants: UNKNOWN->FREE or UNKNOWN->BLOCKED only.
        """
        if not self._check_cell_index(row, col):
            return False
        cur = self.cells[row][col]
        if cur != CellState.CELL_UNKNOWN:
            # Invalid classification transition (CMP--3 Failures)
            return False
        if new_state not in (CellState.CELL_FREE, CellState.CELL_BLOCKED):
            return False
        self.cells[row][col] = new_state
        self._unknown_cells -= 1
        self._update_completeness_flag()
        return True

    def get_horizontal_wall_state(self, row: int, col: int) -> int:
        if not (0 <= row < self.rows - 1 and 0 <= col < self.cols):
            return WallState.WALL_PRESENT
        return self.h_walls[row][col]

    def set_horizontal_wall_unknown_to(self, row: int, col: int, new_state: int) -> bool:
        if not (0 <= row < self.rows - 1 and 0 <= col < self.cols):
            return False
        cur = self.h_walls[row][col]
        if cur != WallState.WALL_UNKNOWN:
            return False
        if new_state not in (WallState.WALL_PRESENT, WallState.WALL_ABSENT):
            return False
        self.h_walls[row][col] = new_state
        self._unknown_walls -= 1
        self._update_completeness_flag()
        return True

    def get_vertical_wall_state(self, row: int, col: int) -> int:
        if not (0 <= row < self.rows and 0 <= col < self.cols - 1):
            return WallState.WALL_PRESENT
        return self.v_walls[row][col]

    def set_vertical_wall_unknown_to(self, row: int, col: int, new_state: int) -> bool:
        if not (0 <= row < self.rows and 0 <= col < self.cols - 1):
            return False
        cur = self.v_walls[row][col]
        if cur != WallState.WALL_UNKNOWN:
            return False
        if new_state not in (WallState.WALL_PRESENT, WallState.WALL_ABSENT):
            return False
        self.v_walls[row][col] = new_state
        self._unknown_walls -= 1
        self._update_completeness_flag()
        return True

    def neighbors4(self, row: int, col: int) -> List[CellIndex]:
        """Get 4-connected neighbors within grid (no wall checking)."""
        nbs: List[CellIndex] = []
        if row > 0:
            nbs.append((row - 1, col))
        if row < self.rows - 1:
            nbs.append((row + 1, col))
        if col > 0:
            nbs.append((row, col - 1))
        if col < self.cols - 1:
            nbs.append((row, col + 1))
        return nbs

    def is_edge_traversable(self, a: CellIndex, b: CellIndex) -> bool:
        """CMP--4: implement 4-connected neighbors between FREE cells not separated by PRESENT walls."""
        ar, ac = a
        br, bc = b
        if not (self._check_cell_index(ar, ac) and self._check_cell_index(br, bc)):
            return False
        if self.cells[ar][ac] != CellState.CELL_FREE:
            return False
        if self.cells[br][bc] != CellState.CELL_FREE:
            return False

        dr = br - ar
        dc = bc - ac
        if abs(dr) + abs(dc) != 1:
            return False

        # Vertical move (north/south) => horizontal wall
        if dr == 1:  # moving down from (ar,ac) to (ar+1, ac)
            ws = self.get_horizontal_wall_state(ar, ac)
        elif dr == -1:  # up
            ws = self.get_horizontal_wall_state(br, bc)
        else:
            # Horizontal move => vertical wall
            if dc == 1:  # right
                ws = self.get_vertical_wall_state(ar, ac)
            else:        # left
                ws = self.get_vertical_wall_state(br, bc)
        return ws != WallState.WALL_PRESENT

    # ===== Completeness tracking (CMP--3, CMP--11) =========================

    def _update_completeness_flag(self) -> None:
        self.map_complete = (self._unknown_cells == 0 and self._unknown_walls == 0)
]]>
