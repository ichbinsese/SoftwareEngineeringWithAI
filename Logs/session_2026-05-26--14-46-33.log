from core import config
from core.grid_map import CellState


class WallDetectionResult:
    """
    Simple structure for MM_WallDetectionResult (CMP--6.Transmit).
    """
    def __init__(self, front=False, left=False, right=False):
        self.front = front
        self.left = left
        self.right = right


class MappingModule:
    """
    Mapping and Wall Detection Module.

    Tracing:
      - Component: CMP--6
      - Requirements tied via Design to LL--MAP--1.2.x, 1.3.x, 1.4.x
    """

    def __init__(self, grid_map):
        self.map = grid_map
        # Hysteresis and consistency state (DAT--5)
        self.front_count = 0
        self.left_count = 0
        self.right_count = 0

    def process(self, filtered_data, pose_estimate):
        """
        Per control loop processing (CMP--6.Execution).

        Args:
            filtered_data: FilteredSensorData from SAL (CMP--7).
            pose_estimate: PoseEstimate from CMP--9.
        Returns:
            WallDetectionResult for motion control and pose correction.
        """
        front = False
        left = False
        right = False

        # 2) Front wall detection via ultrasonic (simplified, DAT--4)
        d = filtered_data.distance_cm
        expected = config.CELL_LENGTH_CM / 2.0  # approximate, from DAT--4
        lo = expected - 12.0
        hi = expected + 12.0
        if lo <= d <= hi:
            self.front_count += 1
        else:
            self.front_count = 0

        if self.front_count >= config.CONSISTENCY_THRESHOLD_N:
            front = True

        # 2) Side walls via IR (simplified)
        if filtered_data.left_flag:
            self.left_count += 1
        else:
            self.left_count = 0

        if filtered_data.right_flag:
            self.right_count += 1
        else:
            self.right_count = 0

        if self.left_count >= config.CONSISTENCY_THRESHOLD_N:
            left = True
        if self.right_count >= config.CONSISTENCY_THRESHOLD_N:
            right = True

        # Map updates (highly simplified for demo; real impl would map walls to edges)
        r, c = pose_estimate.row, pose_estimate.col
        if front:
            # mark next cell as BLOCKED if UNKNOWN (CMP--6.Execution step 5)
            dr, dc = pose_estimate.heading_delta()
            nr, nc = r + dr, c + dc
            if self.map.get_cell_state(nr, nc) == CellState.CELL_UNKNOWN:
                self.map.apply_cell_blocked_request(nr, nc)

        # Free cell confirmation on successful traversal is done via Pose/MC in this simplified version
        return WallDetectionResult(front=front, left=left, right=right)


