from core import config
from core.grid_map import CellState


class FrontierTarget:
    """
    Data holder for selected frontier target (CMP--2.FGM_SelectedTarget).
    """
    def __init__(self, cell=None, est_time_ms=0, est_gain=0, heuristic=0):
        self.cell = cell
        self.estimated_travel_time_ms = est_time_ms
        self.estimated_new_cells = est_gain
        self.heuristic_value = heuristic


class FrontierGenerator:
    """
    Frontier Generation and Exploration Target Selection.

    Tracing:
      - Component: CMP--2
      - Requirements: LL--MAP--1.1.x, LL--PLAN--1.1.x (via design)
      - AdditionalData: DAT--3 (time-aware filtering)
    """

    def __init__(self, grid_map):
        self.map = grid_map
        self.cached_frontiers = []
        self.cache_valid = False

    def invalidate_cache(self):
        self.cache_valid = False

    def recompute_frontiers(self):
        """
        Compute frontier set per CMP--2.Purpose:
        UNKNOWN cells that are 4-neighbors of at least one FREE cell.
        """
        self.cached_frontiers = []
        rows = self.map.rows
        cols = self.map.cols
        for r in range(rows):
            for c in range(cols):
                if self.map.get_cell_state(r, c) != CellState.CELL_UNKNOWN:
                    continue
                neighbors = self.map.get_neighbors4(r, c)
                for nr, nc in neighbors:
                    if self.map.get_cell_state(nr, nc) == CellState.CELL_FREE:
                        self.cached_frontiers.append((r, c))
                        break
        self.cache_valid = True
        return list(self.cached_frontiers)

    def get_frontier_set(self):
        if not self.cache_valid:
            self.recompute_frontiers()
        return list(self.cached_frontiers)

    def select_target(self, current_cell, remaining_time_ms):
        """
        Select heuristic-best frontier subject to remaining time (DAT--3).

        For simplicity:
        - Estimated travel time = Manhattan distance * NOMINAL_CELL_TRAVERSAL_MS.
        - Estimated information gain = 1 (placeholder).
        - Heuristic: lower time better; if tie, arbitrary.
        """
        frontiers = self.get_frontier_set()
        if not frontiers:
            return FrontierTarget(cell=None)  # indicates no target (CMP--2.Failures)

        best = None
        best_heuristic = None

        for fr in frontiers:
            dist_cells = abs(fr[0] - current_cell[0]) + abs(fr[1] - current_cell[1])
            est_travel_ms = dist_cells * config.NOMINAL_CELL_TRAVERSAL_MS
            est_overhead_ms = config.NOMINAL_CELL_TRAVERSAL_MS
            if est_travel_ms + est_overhead_ms > remaining_time_ms:
                # discard infeasible (CMP--2.Failures, DAT--3)
                continue
            heuristic = est_travel_ms  # simple time-based heuristic
            if best is None or heuristic < best_heuristic:
                best = fr
                best_heuristic = heuristic

        if best is None:
            # no feasible frontier under time limit
            return FrontierTarget(cell=None)

        return FrontierTarget(
            cell=best,
            est_time_ms=best_heuristic,
            est_gain=1,
            heuristic=best_heuristic,
        )


