# Tracing: CMP--1, FSM--1

from core.events import EventType
from core.planner import PlanningStatus
from core.motion import PathExecutionStatus


class MissionState:
    IDLE = "IDLE"
    EXPLORE = "EXPLORE"
    RETURN_TO_START = "RETURN_TO_START"
    SECOND_RUN = "SECOND_RUN"
    COMPLETED = "COMPLETED"


class SecondRunStatusEnum:
    # Subset of DAT--1.SecondRunStatusEnum mapped to high-level values
    SECOND_RUN_NOT_EXECUTED = 0
    SECOND_RUN_SUCCESS = 1
    SECOND_RUN_FAILURE = 2


class MissionControl:
    """
    Mission Control State Machine, implementing FSM--1.

    Tracing:
      - Component: CMP--1
      - State Machine: FSM--1
    """

    def __init__(self, grid_map, frontier, planner, goal_region_selector,
                 exploration_status_module, motion_controller, pose_estimator, sal):
        self.grid_map = grid_map
        self.frontier = frontier
        self.planner = planner
        self.goal_region_selector = goal_region_selector
        self.es = exploration_status_module
        self.motion = motion_controller
        self.pose_estimator = pose_estimator
        self.sal = sal

        self.state = MissionState.IDLE
        self.second_run_status = SecondRunStatusEnum.SECOND_RUN_NOT_EXECUTED
        self.return_reason = None
        self.init_completed = False

    def set_init_completed(self):
        self.init_completed = True

    def tick(self):
        """
        Execute one mission control cycle (CMP--1.Execution).
        """
        pose = self.pose_estimator.get_pose()

        if self.state == MissionState.IDLE:
            # FSM--1.IDLE StateAction
            self.motion.set_motion_command([], "ExplorationSpeed")
            if self.init_completed and self.sal.sensor_available:
                # FSM--1: IDLE -> EXPLORE transition
                self.state = MissionState.EXPLORE
                self.es.notify_explore_start()
                # TransitionAction: reset timers, init exploration modules

        elif self.state == MissionState.EXPLORE:
            # Check exploration events (CMP--11 -> CMP--1)
            for ev in self.es.events.drain():
                if ev.etype == EventType.EXPLORATION_COMPLETED:
                    self.return_reason = "COMPLETED"
                    self.state = MissionState.RETURN_TO_START
                elif ev.etype == EventType.EXPLORATION_TIMEOUT:
                    if self.state != MissionState.RETURN_TO_START:
                        self.return_reason = "TIMEOUT"
                        self.state = MissionState.RETURN_TO_START

            if self.state == MissionState.EXPLORE:
                # Request frontier and plan
                remaining = self.es.remaining_time_ms()
                target = self.frontier.select_target((pose.row, pose.col), remaining)
                if target.cell is not None:
                    resp = self.planner.plan(
                        request_id="EXPLORE",
                        mode="EXPLORE",
                        start_cell=(pose.row, pose.col),
                        goal_cells=[target.cell],
                    )
                    if resp.status == PlanningStatus.SUCCESS:
                        self.motion.set_motion_command(resp.path, "ExplorationSpeed")

        elif self.state == MissionState.RETURN_TO_START:
            # Request path to start cell if not yet done
            start_cell = (self.grid_map.start_row, self.grid_map.start_col)
            resp = self.planner.plan(
                request_id="RETURN",
                mode="RETURN_TO_START",
                start_cell=(pose.row, pose.col),
                goal_cells=[start_cell],
            )
            if resp.status == PlanningStatus.SUCCESS:
                self.motion.set_motion_command(resp.path, "ReturnSpeed")
                status = self.motion.tick(self.sal.sample_and_filter(), None)
                if status == PathExecutionStatus.REACHED_GOAL:
                    # FSM--1: RETURN_TO_START -> SECOND_RUN
                    self.state = MissionState.SECOND_RUN
            else:
                # Planning failure (CMP--1.Failures)
                self.second_run_status = SecondRunStatusEnum.SECOND_RUN_FAILURE
                self.state = MissionState.COMPLETED

        elif self.state == MissionState.SECOND_RUN:
            # Determine goal region if not selected
            if not self.goal_region_selector.selected_region:
                info = self.goal_region_selector.identify_and_select(
                    (self.grid_map.start_row, self.grid_map.start_col)
                )
                if info is None:
                    self.second_run_status = SecondRunStatusEnum.SECOND_RUN_FAILURE
                    self.state = MissionState.COMPLETED
                    return

            goal_cells = self.goal_region_selector.selected_region.cells
            resp = self.planner.plan(
                request_id="SECOND",
                mode="SECOND_RUN",
                start_cell=(self.grid_map.start_row, self.grid_map.start_col),
                goal_cells=goal_cells,
            )
            if resp.status != PlanningStatus.SUCCESS:
                self.second_run_status = SecondRunStatusEnum.SECOND_RUN_FAILURE
                self.state = MissionState.COMPLETED
                return

            self.motion.set_motion_command(resp.path, "SecondRunSpeed")
            status = self.motion.tick(self.sal.sample_and_filter(), None)
            if status == PathExecutionStatus.REACHED_GOAL:
                self.second_run_status = SecondRunStatusEnum.SECOND_RUN_SUCCESS
                self.state = MissionState.COMPLETED
            elif status == PathExecutionStatus.COLLISION_ABORTED:
                self.second_run_status = SecondRunStatusEnum.SECOND_RUN_FAILURE
                self.state = MissionState.COMPLETED

        elif self.state == MissionState.COMPLETED:
            # FSM--1.COMPLETED StateAction
            self.motion.set_motion_command([], "ExplorationSpeed")
            # MC_SecondRunStatusOutput latched by second_run_status
            pass


