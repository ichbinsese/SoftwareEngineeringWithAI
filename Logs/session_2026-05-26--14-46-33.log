# Entry point for Raspberry Pi Pico Go Micropython implementation.
#
# This file wires all components together based on the design
# (CMP--1..CMP--11, FSM--1, DAT--1..DAT--7) and runs the main scheduler.

from core.grid_map import GridMap
from core.frontier import FrontierGenerator
from core.planner import PathPlanner
from core.goal_region import GoalRegionSelector
from core.sal import SensorAbstractionLayer
from core.mapping import MappingModule
from core.pose import PoseEstimator
from core.motion import MotionController
from core.exploration_status import ExplorationStatusModule
from core.mission_control import MissionControl
from core.scheduler import Scheduler

from drivers.motor_driver import MotorDriver
from drivers.ultrasonic_driver import UltrasonicDriver
from drivers.infrared_driver import InfraredDriver


def main():
    # Instantiate hardware drivers
    motor_drv = MotorDriver()
    ultra_drv = UltrasonicDriver()
    ir_drv = InfraredDriver()

    # Core modules per design
    grid_map = GridMap(start_row=0, start_col=0)          # CMP--3
    sal = SensorAbstractionLayer(ultra_drv, ir_drv)       # CMP--7
    pose_estimator = PoseEstimator(start_row=0, start_col=0)  # CMP--9
    mapping = MappingModule(grid_map)                     # CMP--6
    frontier = FrontierGenerator(grid_map)                # CMP--2
    planner = PathPlanner(grid_map)                       # CMP--4
    goal_region = GoalRegionSelector(grid_map, planner)   # CMP--5
    exploration_status = ExplorationStatusModule(grid_map)  # CMP--11
    motion = MotionController(motor_drv)                  # CMP--8

    # Mission control and scheduler
    mission_control = MissionControl(
        grid_map=grid_map,
        frontier=frontier,
        planner=planner,
        goal_region_selector=goal_region,
        exploration_status_module=exploration_status,
        motion_controller=motion,
        pose_estimator=pose_estimator,
        sal=sal,
    )  # CMP--1 / FSM--1

    sched = Scheduler(
        mission_control=mission_control,
        sal=sal,
        mapping=mapping,
        pose_estimator=pose_estimator,
        grid_map=grid_map,
        exploration_status=exploration_status,
        motion_controller=motion,
    )  # CMP--10

    sched.initialize()
    sched.run()


if __name__ == "__main__":
    main()


