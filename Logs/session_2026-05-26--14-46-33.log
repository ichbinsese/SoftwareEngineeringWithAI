# Tracing: CMP--3, DAT--1

from core import config

# === Enums (DAT--1) ===
class CellState:
    CELL_UNKNOWN = 0
    CELL_FREE = 1
    CELL_BLOCKED = 2


class WallState:
    WALL_UNKNOWN = 0
    WALL_PRESENT = 1
    WALL_ABSENT = 2


class GridMap:
    """
    In-memory 4x8 grid map with wall segments and completeness tracking.

    Tracing:
      - Component: CMP--3 (Grid Map Module)
      - Requirements: LL--MAP--1.3.x, LL--MAP--1.4.x (via Design)
      - Additional data: DAT--1 (data structures)
    """

    def __init__(self, start_row=0, start_col=0):
        # CMP--3.Execution: Map initialization at startup
        self.rows = config.GRID_ROWS
        self.cols = config.GRID_COLS

        # Cells: 4x8
        self.cells = [[CellState.CELL_UNKNOWN for _ in range(self.cols)]
                      for _ in range(self.rows)]
        # Horizontal walls: between row and row+1 -> (rows-1) x cols
        self.h_walls = [[WallState.WALL_UNKNOWN for _ in range(self.cols)]
                        for _ in range(self.rows - 1)]
        # Vertical walls: between col and col+1 -> rows x (cols-1)
        self.v_walls = [[WallState.WALL_UNKNOWN for _ in range(self.cols - 1)]
                        for _ in range(self.rows)]

        self.start_row = start_row
        self.start_col = start_col

        # Completeness counters (CMP--3.Execution step 6)
        self.unknown_cells = self.rows * self.cols
        self.unknown_walls = (self.rows - 1) * self.cols + self.rows * (self.cols - 1)
        self.map_complete = False

        # Initialize start cell as FREE
        self._set_cell_state_internal(start_row, start_col, CellState.CELL_FREE)

    # === Internal helpers enforcing invariants (CMP--3.Invariants) ===

    def _in_bounds_cell(self, row, col):
        return 0 <= row < self.rows and 0 <= col < self.cols

    def _in_bounds_hwall(self, r, c):
        return 0 <= r < self.rows - 1 and 0 <= c < self.cols

    def _in_bounds_vwall(self, r, c):
        return 0 <= r < self.rows and 0 <= c < self.cols - 1

    def _set_cell_state_internal(self, row, col, new_state):
        if not self._in_bounds_cell(row, col):
            return False
        old = self.cells[row][col]
        if old == new_state:
            return True
        # Allowed transitions: UNKNOWN -> FREE/BLOCKED only (CMP--3.Invariants)
        if old != CellState.CELL_UNKNOWN:
            return False
        self.cells[row][col] = new_state
        if old == CellState.CELL_UNKNOWN:
            self.unknown_cells -= 1
        self._update_completeness_flag()
        return True

    def _set_wall_state_internal(self, vertical, r, c, new_state):
        if vertical:
            if not self._in_bounds_vwall(r, c):
                return False
            arr = self.v_walls
        else:
            if not self._in_bounds_hwall(r, c):
                return False
            arr = self.h_walls
        old = arr[r][c]
        if old == new_state:
            return True
        # Allowed transitions: UNKNOWN -> PRESENT/ABSENT only (CMP--3.Invariants)
        if old != WallState.WALL_UNKNOWN:
            return False
        arr[r][c] = new_state
        if old == WallState.WALL_UNKNOWN:
            self.unknown_walls -= 1
        self._update_completeness_flag()
        return True

    def _update_completeness_flag(self):
        # CMP--3.Execution step 6
        self.map_complete = (self.unknown_cells == 0 and self.unknown_walls == 0)

    # === Public API (GM_MapData, GM_MapCompletenessFlag in CMP--3.ConnectedComponents) ===

    def get_cell_state(self, row, col):
        if not self._in_bounds_cell(row, col):
            return None
        return self.cells[row][col]

    def get_neighbors4(self, row, col):
        # 4-connected adjacency (used by FGM and planner)
        res = []
        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
            nr, nc = row + dr, col + dc
            if self._in_bounds_cell(nr, nc):
                res.append((nr, nc))
        return res

    def get_wall_state_between(self, r1, c1, r2, c2):
        # Horizontal adjacency
        if r1 == r2 and abs(c1 - c2) == 1:
            r = r1
            c = min(c1, c2)
            return self.v_walls[r][c]
        # Vertical adjacency
        if c1 == c2 and abs(r1 - r2) == 1:
            r = min(r1, r2)
            c = c1
            return self.h_walls[r][c]
        return None

    def is_complete(self):
        # GM_MapCompletenessFlag (CMP--3.Transmit)
        return self.map_complete

    # === Map update requests (MM_MapUpdateRequest handlers for CMP--6) ===

    def apply_cell_free_request(self, row, col):
        """
        UNKNOWN -> FREE request (CMP--3.Execution, MM_MapUpdateRequest, UNKNOWN->FREE)
        """
        return self._set_cell_state_internal(row, col, CellState.CELL_FREE)

    def apply_cell_blocked_request(self, row, col):
        """
        UNKNOWN -> BLOCKED request (CMP--3.Execution, MM_MapUpdateRequest, UNKNOWN->BLOCKED)
        """
        return self._set_cell_state_internal(row, col, CellState.CELL_BLOCKED)

    def apply_wall_present_request(self, r1, c1, r2, c2):
        """
        UNKNOWN -> PRESENT wall request and blocked cell inference for neighbor cell (CMP--3.Execution 2,5).
        """
        # Decide vertical vs horizontal
        if r1 == r2 and abs(c1 - c2) == 1:
            # vertical wall
            r = r1
            c = min(c1, c2)
            ok = self._set_wall_state_internal(True, r, c, WallState.WALL_PRESENT)
        elif c1 == c2 and abs(r1 - r2) == 1:
            # horizontal wall
            r = min(r1, r2)
            c = c1
            ok = self._set_wall_state_internal(False, r, c, WallState.WALL_PRESENT)
        else:
            return False
        # neighbor blocked inference (LL--MAP--1.4.4)
        # For simplicity, infer blocked on the farther cell
        if r1 == r2:
            blocked_row, blocked_col = r1, max(c1, c2)
        else:
            blocked_row, blocked_col = max(r1, r2), c1
        self.apply_cell_blocked_request(blocked_row, blocked_col)
        return ok

    def apply_wall_absent_request(self, r1, c1, r2, c2):
        """
        UNKNOWN -> ABSENT wall request (CMP--3.Execution 3).
        """
        if r1 == r2 and abs(c1 - c2) == 1:
            r = r1
            c = min(c1, c2)
            return self._set_wall_state_internal(True, r, c, WallState.WALL_ABSENT)
        if c1 == c2 and abs(r1 - r2) == 1:
            r = min(r1, r2)
            c = c1
            return self._set_wall_state_internal(False, r, c, WallState.WALL_ABSENT)
        return False


