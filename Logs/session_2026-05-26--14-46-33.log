import time
from core import config
from core.events import EventQueue, Event, EventType


class ExplorationStatusModule:
    """
    Exploration Status and Time Limit Module.

    Tracing:
      - Component: CMP--11
    """

    def __init__(self, grid_map):
        self.map = grid_map
        self.events = EventQueue()
        self.explore_started = False
        self.start_time_ms = 0
        self.completed_emitted = False
        self.timeout_emitted = False

    def notify_explore_start(self):
        # Called by Mission Control when entering EXPLORE (FSM--1, CMP--1)
        self.explore_started = True
        self.start_time_ms = time.ticks_ms()

    def tick(self):
        """
        Called once per control loop by scheduler (CMP--11.Execution).
        """
        if not self.explore_started:
            return

        now = time.ticks_ms()
        elapsed = time.ticks_diff(now, self.start_time_ms)
        if (not self.timeout_emitted) and elapsed >= config.EXPLORATION_TIME_LIMIT_MS:
            self.timeout_emitted = True
            self.events.enqueue(Event(EventType.EXPLORATION_TIMEOUT))

        if (not self.completed_emitted) and self.map.is_complete():
            self.completed_emitted = True
            self.events.enqueue(Event(EventType.EXPLORATION_COMPLETED))

    def remaining_time_ms(self):
        if not self.explore_started:
            return config.EXPLORATION_TIME_LIMIT_MS
        now = time.ticks_ms()
        elapsed = time.ticks_diff(now, self.start_time_ms)
        rem = config.EXPLORATION_TIME_LIMIT_MS - elapsed
        if rem < 0:
            rem = 0
        return rem


