# Tracing: DAT--7, CMP--1, CMP--11

import time

class EventType:
    # High-level mission and exploration events (DAT--7)
    EXPLORATION_COMPLETED = "EXPLORATION_COMPLETED"
    EXPLORATION_TIMEOUT = "EXPLORATION_TIMEOUT"
    PATH_INVALIDATED = "PATH_INVALIDATED"
    RETURN_COMPLETED = "RETURN_COMPLETED"
    SECOND_RUN_COMPLETED = "SECOND_RUN_COMPLETED"


class Event:
    """
    Simple event structure matching DAT--7.
    """
    # Tracing: DAT--7
    __slots__ = ("etype", "timestamp_ms", "payload")

    def __init__(self, etype, payload=None):
        self.etype = etype
        self.timestamp_ms = time.ticks_ms()
        self.payload = payload


class EventQueue:
    """
    Fixed-size circular buffer for events (DAT--7).
    Used mainly by CMP--11 (exploration status) and CMP--1 (mission control).
    """
    # Tracing: DAT--7, CMP--1, CMP--11
    def __init__(self, capacity=16):
        self._buf = [None] * capacity
        self._capacity = capacity
        self._head = 0
        self._tail = 0
        self._size = 0

    def enqueue(self, event):
        if self._size == self._capacity:
            # Drop oldest event on overflow (policy for simplicity)
            self._head = (self._head + 1) % self._capacity
            self._size -= 1
        self._buf[self._tail] = event
        self._tail = (self._tail + 1) % self._capacity
        self._size += 1

    def dequeue(self):
        if self._size == 0:
            return None
        e = self._buf[self._head]
        self._buf[self._head] = None
        self._head = (self._head + 1) % self._capacity
        self._size -= 1
        return e

    def drain(self):
        """
        Yield all events currently queued and empty the queue.
        """
        events = []
        while True:
            e = self.dequeue()
            if e is None:
                break
            events.append(e)
        return events


