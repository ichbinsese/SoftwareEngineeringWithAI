from core import config


class PoseEstimate:
    """
    Pose estimate for cell-level planning (CMP--9.Transmit PoseEstimate).
    """
    def __init__(self, row=0, col=0, heading_idx=0):
        # heading_idx: 0=NORTH, 1=EAST, 2=SOUTH, 3=WEST
        self.row = row
        self.col = col
        self.heading_idx = heading_idx

    def heading_delta(self):
        """
        Return (dr, dc) motion vector for one-cell forward move.
        """
        if self.heading_idx == 0:   # NORTH -> negative row
            return -1, 0
        if self.heading_idx == 1:   # EAST
            return 0, 1
        if self.heading_idx == 2:   # SOUTH
            return 1, 0
        # WEST
        return 0, -1


class PoseEstimator:
    """
    Pose Estimation Module.

    Tracing:
      - Component: CMP--9
    """

    def __init__(self, start_row=0, start_col=0):
        self.pose = PoseEstimate(start_row, start_col, 0)

    def update_from_motion(self, left_speed, right_speed):
        """
        Simplified: integrate kinematics in a discrete fashion using sign of speeds.

        For demonstration:
        - If both positive: move forward one cell when enough cycles accumulated.
        - If left>right: turn right 90 over some cycles, etc.

        Full continuous model omitted due to platform constraints.
        """
        # Stub: no continuous integration, assume mission control triggers cell-level updates
        pass

    def get_pose(self):
        return self.pose


