# Tracing: CMP--10

import time
from core import config


class Scheduler:
    """
    Scheduler and Initialization.

    Tracing:
      - Component: CMP--10
    """

    def __init__(self, mission_control, sal, mapping, pose_estimator,
                 grid_map, exploration_status, motion_controller):
        self.mc = mission_control
        self.sal = sal
        self.mapping = mapping
        self.pose_estimator = pose_estimator
        self.grid_map = grid_map
        self.es = exploration_status
        self.motion = motion_controller

    def initialize(self):
        """
        Hardware and software init (CMP--10.Execution startup).
        """
        # In this simple implementation, assume init always succeeds.
        self.mc.set_init_completed()

    def run(self):
        """
        Main control loop (CMP--10.Execution periodic).
        """
        period_ms = config.CONTROL_LOOP_PERIOD_MS
        next_tick = time.ticks_ms()

        while True:
            now = time.ticks_ms()
            if time.ticks_diff(now, next_tick) < 0:
                # Sleep until next period
                time.sleep_ms(1)
                continue

            # 1) Emit Sched_ControlLoopTick (implicit by ticking components)
            next_tick = time.ticks_add(next_tick, period_ms)

            # 2) Sample sensors
            filtered = self.sal.sample_and_filter()

            # 3) Update mapping (walls, cells) using last pose
            pose = self.pose_estimator.get_pose()
            wall_det = self.mapping.process(filtered, pose)

            # 4) Exploration status timing
            self.es.tick()

            # 5) Mission control state machine
            self.mc.tick()

            # 6) Motion control (if not already advanced within MC)
            self.motion.tick(filtered, wall_det)


