import time
from collections import deque
from core import config


class FilteredSensorData:
    """
    Normalized filtered sensor data (CMP--7.Transmit SAL_FilteredSensorData).
    """
    def __init__(self, dist_cm=999.0, left=False, right=False, ts_ms=0):
        self.distance_cm = dist_cm
        self.left_flag = left
        self.right_flag = right
        self.timestamp_ms = ts_ms


class SensorAbstractionLayer:
    """
    Sensor Abstraction and Filtering Layer.

    Tracing:
      - Component: CMP--7
      - AdditionalData: DAT--5
    """

    def __init__(self, ultrasonic_drv, infrared_drv):
        self.ultrasonic = ultrasonic_drv
        self.infrared = infrared_drv
        self.ultra_buf = deque(maxlen=config.ULTRASONIC_FILTER_WINDOW)
        self.ir_left_buf = deque(maxlen=config.IR_FILTER_WINDOW)
        self.ir_right_buf = deque(maxlen=config.IR_FILTER_WINDOW)
        self.sensor_available = False

    def _filter_avg_bool(self, buf):
        if not buf:
            return False
        return sum(1 for v in buf if v) * 2 >= len(buf)

    def _filter_avg_float(self, buf):
        if not buf:
            return 999.0
        return sum(buf) / len(buf)

    def sample_and_filter(self):
        """
        To be called once per control loop (Sched_ControlLoopTick, CMP--7.Execution).
        """
        ts = time.ticks_ms()

        # Raw sampling (CMP--7.Execution step 1)
        raw_dist = self.ultrasonic.distance()
        raw_left = bool(self.infrared.dsl())
        raw_right = bool(self.infrared.dsr())

        # Sanitize ultrasonic (CMP--7.Execution step 2)
        if raw_dist is None or raw_dist < 0 or raw_dist != raw_dist:  # NaN check
            dist = 999.0
            valid_ultra = False
        else:
            dist = raw_dist
            valid_ultra = True

        # Assume IR always returns a bool; treat as valid
        self.ultra_buf.append(dist)
        self.ir_left_buf.append(raw_left)
        self.ir_right_buf.append(raw_right)

        filtered_dist = self._filter_avg_float(self.ultra_buf)
        filtered_left = self._filter_avg_bool(self.ir_left_buf)
        filtered_right = self._filter_avg_bool(self.ir_right_buf)

        # Update availability status (CMP--7.Transmit SensorAvailabilityStatus)
        if valid_ultra:
            if filtered_left is not None and filtered_right is not None:
                self.sensor_available = True

        return FilteredSensorData(
            dist_cm=filtered_dist,
            left=filtered_left,
            right=filtered_right,
            ts_ms=ts,
        )


