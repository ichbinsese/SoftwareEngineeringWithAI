# Tracing: CMP--8, DAT--4, DAT--6

from core import config
from drivers.motor_driver import MotorDriver


class PathExecutionStatus:
    RUNNING = "RUNNING"
    REACHED_GOAL = "REACHED_GOAL"
    PATH_INVALID = "PATH_INVALID"
    COLLISION_ABORTED = "COLLISION_ABORTED"


class MotionController:
    """
    Motion Control and Collision Avoidance.

    Tracing:
      - Component: CMP--8
      - AdditionalData: DAT--4, DAT--6
    """

    MODE_NORMAL = 0
    MODE_AVOIDANCE = 1
    MODE_EMERGENCY_STOPPED = 2

    def __init__(self, motor: MotorDriver):
        self.motor = motor
        self.mode = self.MODE_NORMAL
        self.left_speed = 0
        self.right_speed = 0
        self.current_path = []
        self.path_index = 0
        self.speed_profile = "ExplorationSpeed"

    def _apply_rate_limited(self, target_left, target_right):
        """
        Enforce rate limiting per CMP--8.Invariants, except for emergency stop.
        """
        dl = target_left - self.left_speed
        dr = target_right - self.right_speed
        max_delta = config.MAX_SPEED_DELTA_PER_CYCLE
        if dl > max_delta:
            dl = max_delta
        if dl < -max_delta:
            dl = -max_delta
        if dr > max_delta:
            dr = max_delta
        if dr < -max_delta:
            dr = -max_delta
        self.left_speed += dl
        self.right_speed += dr
        self.motor.set(self.left_speed, self.right_speed)

    def emergency_stop(self):
        """
        Immediate EM stop (CMP--8.Failures Emergency stop).
        """
        self.mode = self.MODE_EMERGENCY_STOPPED
        self.left_speed = 0
        self.right_speed = 0
        self.motor.stop()

    def set_motion_command(self, path, speed_profile):
        """
        Accept MC_MotionCommand from CMP--1.

        Args:
            path: list of cells to follow.
            speed_profile: {"ExplorationSpeed", "ReturnSpeed", "SecondRunSpeed"}.
        """
        if self.mode == self.MODE_EMERGENCY_STOPPED:
            # Accept new safe command to leave EMERGENCY_STOPPED (CMP--8.Invariants)
            self.mode = self.MODE_NORMAL
        self.current_path = list(path or [])
        self.path_index = 0
        self.speed_profile = speed_profile

    def _profile_speed(self):
        if self.speed_profile == "SecondRunSpeed":
            return config.MAX_SECOND_RUN_SPEED
        return config.MAX_EXPLORATION_SPEED

    def tick(self, filtered_sensor, wall_detection):
        """
        Per control loop step (CMP--8.Execution).

        Args:
            filtered_sensor: FilteredSensorData from SAL.
            wall_detection: WallDetectionResult from Mapping.
        Returns:
            PathExecutionStatus or None when still running.
        """
        # 2) Emergency stop check
        if self.mode != self.MODE_EMERGENCY_STOPPED:
            if filtered_sensor.distance_cm <= config.EMERGENCY_STOP_DISTANCE_CM:
                self.emergency_stop()
                return PathExecutionStatus.COLLISION_ABORTED

        if self.mode == self.MODE_EMERGENCY_STOPPED:
            # Keep motors stopped
            self.motor.stop()
            return PathExecutionStatus.PATH_INVALID

        # Simplified path following: if path not empty, just drive forward
        if not self.current_path or self.path_index >= len(self.current_path) - 1:
            # No path or at final cell: stop
            self._apply_rate_limited(0, 0)
            return PathExecutionStatus.REACHED_GOAL

        # In actual implementation we would use pose to progress; here we just
        # move along discrete path index each tick for demonstration.
        target_speed = self._profile_speed()
        self._apply_rate_limited(target_speed, target_speed)
        self.path_index += 1
        return PathExecutionStatus.RUNNING


