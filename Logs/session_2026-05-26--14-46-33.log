# Tracing: CMP--4, DAT--2

from core import config
from core.grid_map import CellState


class PlanningStatus:
    SUCCESS = "SUCCESS"
    FAILURE_NO_PATH = "FAILURE_NO_PATH"
    FAILURE_TIMEOUT = "FAILURE_TIMEOUT"
    INVALID_GOAL = "INVALID_GOAL"


class PlannerResponse:
    """
    Models PL_PathPlanningResponse (CMP--4.Transmit).
    """
    def __init__(self, request_id, status, path=None, total_cost=0.0, est_time_ms=0):
        self.request_id = request_id
        self.status = status
        self.path = path or []
        self.total_cost = total_cost
        self.estimated_time_ms = est_time_ms


class PathPlanner:
    """
    Simple A*-like planner on 4x8 grid.

    Tracing:
      - Component: CMP--4
      - Uses traversal cost model DAT--2
    """

    def __init__(self, grid_map):
        self.map = grid_map

    def _neighbors_free(self, cell):
        r, c = cell
        res = []
        for nr, nc in self.map.get_neighbors4(r, c):
            if self.map.get_cell_state(nr, nc) != CellState.CELL_FREE:
                continue
            wall_state = self.map.get_wall_state_between(r, c, nr, nc)
            from core.grid_map import WallState
            if wall_state == WallState.WALL_PRESENT:
                continue
            res.append((nr, nc))
        return res

    def _heuristic(self, a, b):
        # Manhattan distance, scaled by BASE_STRAIGHT_COST (DAT--2)
        return (abs(a[0] - b[0]) + abs(a[1] - b[1])) * config.BASE_STRAIGHT_COST

    def plan(self, request_id, mode, start_cell, goal_cells):
        """
        mode in {"EXPLORE", "RETURN_TO_START", "SECOND_RUN"}
        goal_cells: list of candidate goal cells.
        """
        # Validate
        if not goal_cells:
            return PlannerResponse(request_id, PlanningStatus.INVALID_GOAL)

        # Multi-goal: run single-source A* until we reach any of them.
        # For small 4x8 grid, this is fine.
        open_set = [start_cell]
        came_from = {}
        g_score = {start_cell: 0.0}
        from heapq import heappush, heappop
        heap = []
        goal_set = set(goal_cells)
        goal_reached = None

        heappush(heap, (0.0, start_cell))

        while heap:
            _, current = heappop(heap)
            if current in goal_set:
                goal_reached = current
                break
            for nb in self._neighbors_free(current):
                tentative_g = g_score[current] + config.BASE_STRAIGHT_COST
                if nb not in g_score or tentative_g < g_score[nb]:
                    g_score[nb] = tentative_g
                    came_from[nb] = current
                    # Use heuristic toward closest goal
                    h_vals = [self._heuristic(nb, g) for g in goal_cells]
                    h = min(h_vals) if h_vals else 0.0
                    f = tentative_g + h
                    heappush(heap, (f, nb))

        if goal_reached is None:
            return PlannerResponse(request_id, PlanningStatus.FAILURE_NO_PATH)

        # Reconstruct path
        path = [goal_reached]
        cur = goal_reached
        while cur != start_cell:
            cur = came_from[cur]
            path.append(cur)
        path.reverse()

        total_cost = g_score[goal_reached]
        est_time_ms = int(len(path) * config.NOMINAL_CELL_TRAVERSAL_MS)
        return PlannerResponse(
            request_id=request_id,
            status=PlanningStatus.SUCCESS,
            path=path,
            total_cost=total_cost,
            est_time_ms=est_time_ms,
        )


