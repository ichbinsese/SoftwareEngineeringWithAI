# Tracing: CMP--5

from core.grid_map import CellState


class GoalRegionInfo:
    """
    Represents selected goal region for second run (CMP--5.Transmit).
    """
    def __init__(self, cells=None, chosen_goal_cell=None, cost=0.0):
        self.cells = cells or []
        self.chosen_goal_cell = chosen_goal_cell
        self.cost = cost


class GoalRegionSelector:
    """
    Goal Region Identification and Selection.

    Tracing:
      - Component: CMP--5
    """

    def __init__(self, grid_map, planner):
        self.map = grid_map
        self.planner = planner
        self.selected_region = None

    def identify_and_select(self, start_cell):
        """
        Implements CMP--5.Execution.
        Enumerate 2x2 blocks, check all FREE, compute path via planner, pick minimal cost.
        """
        rows = self.map.rows
        cols = self.map.cols
        best_region = None
        best_cost = None
        best_goal_cell = None

        region_id = 0
        for r in range(rows - 1):
            for c in range(cols - 1):
                cells = [(r, c), (r, c + 1), (r + 1, c), (r + 1, c + 1)]
                all_free = True
                for (rr, cc) in cells:
                    if self.map.get_cell_state(rr, cc) != CellState.CELL_FREE:
                        all_free = False
                        break
                if not all_free:
                    continue
                # Ask planner for cheapest path to any cell in region
                req_id = "GR_%d" % region_id
                from core.planner import PlanningStatus
                resp = self.planner.plan(req_id, "SECOND_RUN", start_cell, cells)
                if resp.status != PlanningStatus.SUCCESS or not resp.path:
                    continue
                cost = resp.total_cost
                goal_cell = resp.path[-1]
                if best_cost is None or cost < best_cost:
                    best_cost = cost
                    best_region = cells
                    best_goal_cell = goal_cell
                region_id += 1

        if best_region is None:
            self.selected_region = None
            return None

        info = GoalRegionInfo(best_region, best_goal_cell, best_cost)
        self.selected_region = info
        return info


